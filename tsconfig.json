{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.d.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", ".vitepress/dist", ".vitepress/dist-relay", ".vitepress/cache", ".vitepress/cache-relay"]
}
