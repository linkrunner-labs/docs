{
  "name": "linkrunner-docs-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Linkrunner documentation built with VitePress (migrated from Mintlify)",
  "type": "module",
  "scripts": {
    "convert": "bun run scripts/convert.ts",
    "redirects": "bun run scripts/gen-redirects.ts",
    "legacy-urls": "bun run scripts/legacy-urls.ts",
    "dev": "vitepress dev --port 3001",
    "build": "vitepress build && bun run redirects",
    "preview": "vitepress preview --port 3001",
    "dev:relay": "DOCS_THEME=relay vitepress dev --port 3002",
    "build:relay": "bun run scripts/check-relay-nav.ts && bun run scripts/check-ask-ai-links.ts && DOCS_THEME=relay vitepress build && DOCS_THEME=relay bun run redirects && rm -f .vitepress/dist-relay/CNAME && bun run scripts/check-legacy-urls.ts && bun run scripts/check-agent-files.ts && bun run scripts/check-pages.ts --built",
    "preview:relay": "DOCS_THEME=relay vitepress preview --port 3002",
    "relay:sync": "bun run scripts/sync-relay-tokens.ts",
    "check:agents": "bun test scripts/check-agent-instructions.test.ts",
    "check:pages": "bun run scripts/check-pages.ts",
    "check": "tsc --noEmit && oxlint && bun run check:agents && bun run check:pages",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "keywords": [
    "documentation",
    "vitepress",
    "linkrunner"
  ],
  "author": "Linkrunner Team",
  "license": "MIT",
  "devDependencies": {
    "@fontsource/dm-mono": "^5",
    "@fontsource/inter": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/ph": "^1",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.3",
    "@iconify/vue": "^5.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "~1.3.14",
    "markdown-it": "^14",
    "oxlint": "^1.90.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "satori": "^0.35.0",
    "typescript": "^5.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.34",
    "yaml": "^2.9.0"
  }
}
